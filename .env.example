# Copy this file to .env.local and fill in real values for local development.
# In production, set these in Vercel Project Settings → Environment Variables.

# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used by app/api/** route handlers only.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — get these from https://dashboard.stripe.com/apikeys
# Use pk_test_* / sk_test_* during development; pk_live_* / sk_live_* in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret — get this when you create the webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=

# PostHog — analytics. The token is public (client-side safe).
# Override only if you spin up a second project.
NEXT_PUBLIC_POSTHOG_KEY=phc_A8Sp7SLme7FfeasgqM3L4qNxMBjpFr9evEa8ubqvJ4w9
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
# Local: http://localhost:3000
# Vercel preview: https://$VERCEL_URL is auto-injected; set this only for production domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used to forward wholesale inquiries to the founder.
# Get a key at https://resend.com/api-keys. Server-only.
# If unset, the wholesale apply flow still saves to supabase but no email
# notification is sent.
RESEND_API_KEY=
# Where wholesale inquiries get forwarded.
WHOLESALE_NOTIFY_EMAIL=tennysontaggart@gmail.com
# Verified Resend sender. Defaults to onboarding@resend.dev (works without
# a verified domain, but may land in spam). Replace with a verified address
# on your own domain once set up.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Shippo — USPS label printing from the admin orders page.
# Get a token at https://apps.goshippo.com/settings/api. Server-only.
# Without this, the "buy USPS label" button in the order modal returns
# a clear 503 telling the admin to configure it.
SHIPPO_API_KEY=
# Optional ship-from defaults (used as the return address on every label).
# All in plain US format.
SHIPPO_SHIP_FROM_NAME=Kiwi Pop
SHIPPO_SHIP_FROM_STREET1=
SHIPPO_SHIP_FROM_CITY=Salt Lake City
SHIPPO_SHIP_FROM_STATE=UT
SHIPPO_SHIP_FROM_ZIP=
SHIPPO_SHIP_FROM_PHONE=
SHIPPO_SHIP_FROM_EMAIL=
# Optional default parcel dims (inches + ounces). Defaults to a small candy
# box (6×4×2 in, 4 oz). Override per-batch if your packaging changes.
SHIPPO_PARCEL_LENGTH_IN=6
SHIPPO_PARCEL_WIDTH_IN=4
SHIPPO_PARCEL_HEIGHT_IN=2
SHIPPO_PARCEL_WEIGHT_OZ=4
