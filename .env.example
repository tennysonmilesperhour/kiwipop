# Copy this file to .env.local and fill in real values for local development.
# In production, set these in Vercel Project Settings → Environment Variables.

# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used by app/api/** route handlers only.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — get these from https://dashboard.stripe.com/apikeys
# Use pk_test_* / sk_test_* during development; pk_live_* / sk_live_* in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret — get this when you create the webhook endpoint in Stripe.
STRIPE_WEBHOOK_SECRET=

# PostHog — analytics. The token is public (client-side safe).
# Override only if you spin up a second project.
NEXT_PUBLIC_POSTHOG_KEY=phc_A8Sp7SLme7FfeasgqM3L4qNxMBjpFr9evEa8ubqvJ4w9
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
# Local: http://localhost:3000
# Vercel preview: https://$VERCEL_URL is auto-injected; set this only for production domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used to forward wholesale inquiries to the founder.
# Get a key at https://resend.com/api-keys. Server-only.
# If unset, the wholesale apply flow still saves to supabase but no email
# notification is sent.
RESEND_API_KEY=
# Where wholesale inquiries get forwarded.
WHOLESALE_NOTIFY_EMAIL=tennysontaggart@gmail.com
# Verified Resend sender. Defaults to onboarding@resend.dev (works without
# a verified domain, but may land in spam). Replace with a verified address
# on your own domain once set up.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where "you made a sale" alerts go — one email is sent for every paid order
# (and donation) as soon as Stripe confirms payment. Comma-separate for more
# than one inbox. Defaults to tennysontaggart@gmail.com if unset.
SALE_NOTIFY_EMAIL=tennysontaggart@gmail.com

# ShipStation — USPS label printing from the admin orders page.
# Sign up at https://www.shipstation.com (paid plans start ~$10/mo and
# include commercial USPS rates with no per-label markup). After signing
# up, connect Stamps.com inside ShipStation (their default USPS
# integration), then create an API key + secret at
# https://ship.shipstation.com/settings/api → "Generate API Keys".
# Server-only. Without these, the "buy USPS label" button in the order
# modal returns a clean 503 asking you to configure them.
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
# Carrier + service to use by default. stamps_com is ShipStation's
# built-in USPS account; usps_ground_advantage is the cheapest USPS
# small-package service (replaces First-Class Package as of 2023).
SHIPSTATION_CARRIER_CODE=stamps_com
SHIPSTATION_SERVICE_CODE=usps_ground_advantage
SHIPSTATION_PACKAGE_CODE=package
# Ship-from defaults (used as the return address on every label).
# All in plain US format.
SHIPSTATION_SHIP_FROM_NAME=Kiwi Pop
SHIPSTATION_SHIP_FROM_STREET1=
SHIPSTATION_SHIP_FROM_CITY=Salt Lake City
SHIPSTATION_SHIP_FROM_STATE=UT
SHIPSTATION_SHIP_FROM_ZIP=
SHIPSTATION_SHIP_FROM_PHONE=
# Optional default parcel dims (inches + ounces). Defaults to a small
# candy box (6×4×2 in, 4 oz). Override per-batch if your packaging
# changes.
SHIPSTATION_PARCEL_LENGTH_IN=6
SHIPSTATION_PARCEL_WIDTH_IN=4
SHIPSTATION_PARCEL_HEIGHT_IN=2
SHIPSTATION_PARCEL_WEIGHT_OZ=4

# Instagram feed — the landing page's "FOLLOW ON INSTAGRAM" tiles pull live
# posts via Behold (https://behold.so), which handles the Instagram auth +
# token refresh for us. In Behold: connect @the.kiwi.pop, create a feed, choose
# the JSON output, then paste the feed id here (the bit after feeds.behold.so/).
# Server-only. If unset, the grid shows its built-in placeholder tiles.
BEHOLD_FEED_ID=
# Optional: set the full feed URL instead of the id if you ever self-host or
# Behold changes the host. Takes precedence over BEHOLD_FEED_ID.
# BEHOLD_FEED_URL=
