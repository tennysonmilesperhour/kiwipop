{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npx --yes npm@12.2.1 ci --ignore-scripts",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/process-emails",
      "schedule": "0 9 * * *"
    }
  ]
}
